                     PMNS[1,3] ->  If[thetae == 0 && thetamu == 0 && thetatau == 0, 0, -thetae*Conjugate[thetatau]*(r-1)/r/thetatot^2],
                     PMNS[1,4] ->  If[thetae == 0 && thetamu == 0 && thetatau == 0, 0, thetae/r],
                     PMNS[2,1] ->  If[thetae == 0 && thetamu == 0 && thetatau == 0, 0, -Conjugate[thetae]*thetamu*(r-1)/r/thetatot^2],
                     PMNS[2,2] ->  If[thetae == 0 && thetamu == 0 && thetatau == 0, 1, 1-thetamu*Conjugate[thetamu]*(r-1)/r/thetatot^2],
                     PMNS[2,3] ->  If[thetae == 0 && thetamu == 0 && thetatau == 0, 0, -thetamu*Conjugate[thetatau]*(r-1)/r/thetatot^2],
                     PMNS[2,4] ->  If[thetae == 0 && thetamu == 0 && thetatau == 0, 0, thetamu/r],
