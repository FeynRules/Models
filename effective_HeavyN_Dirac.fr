    TeX           -> Superscript[UL,n],
    ComplexParameter -> True,
    Description   -> "Mass eigenstate component of right-handed nu"},

 HEAVR == { 
    ParameterType -> Internal,
    Indices       -> {Index[Heavynus],Index[Neutrinos]},
    Value         -> {HEAVR[1,1] -> 0,  
                      HEAVR[1,2] -> 0, 
