                     PMNS[3,4] ->  If[thetae == 0 && thetamu == 0 && thetatau == 0, 0, thetatau/r]},
    TeX           -> Superscript[U,PMNS],
    TeX           -> Superscript[U,PMNS],
    ComplexParameter -> True,
