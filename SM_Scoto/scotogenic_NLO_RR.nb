Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"load", " ", "model", " ", "files"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"isLeptonMassive", "=", "False"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"switch", " ", "for", " ", 
      RowBox[{"massless", " ", "/", " ", "massive"}], " ", "charged", " ", 
      "leptons"}], ";", " ", 
     RowBox[{"must", " ", "match", " ", "above"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LoadModel", "[", 
     RowBox[{"\"\<sm.fr\>\"", ",", "\"\<scotogenic_bsm_main.fr\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"isLeptonMassive", ",", "\[IndentingNewLine]", 
      RowBox[{"LoadRestriction", "[", 
       RowBox[{
       "\"\<Parts/diagonalCKM.rst\>\"", ",", 
        "\"\<Parts/massless_quarks_4fs.rst\>\""}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"LoadRestriction", "[", 
       RowBox[{
       "\"\<Parts/diagonalCKM.rst\>\"", ",", "\"\<Parts/massless.rst\>\""}], 
       "]"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FeynmanGauge", "=", "True"}], ";"}]}]}]], "Input",
