  RowBox[{
   RowBox[{"LpQCD", " ", "=", " ", 
    RowBox[{"ExpandIndices", "/@", 
     RowBox[{"Expand", "[", 
      RowBox[{"LSM", "+", "LBSMScotogenic"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"WriteUFO", "[", 
    RowBox[{"LpQCD", ",", 
     RowBox[{"Output", "\[Rule]", "\"\<SM_Scotogenic_XLO\>\""}]}], "]"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"isLeptonMassive", ",", "\[IndentingNewLine]", 
    RowBox[{"WriteUFO", "[", 
     RowBox[{"LpQCD", ",", 
      RowBox[{
