Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"generate", " ", "UFO"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Get", "[", "\"\<SM_Scotogenic.nlo\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LpQCD", " ", "=", " ", 
     RowBox[{"ExpandIndices", "/@", 
      RowBox[{"Expand", "[", 
       RowBox[{"LSM", "+", "LBSMScotogenic"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"WriteUFO", "[", 
     RowBox[{"LpQCD", ",", 
      RowBox[{"UVCounterterms", "\[Rule]", "UV$vertlist"}], ",", 
      RowBox[{"R2Vertices", "\[Rule]", "R2$vertlist"}], ",", " ", 
      RowBox[{"Output", "\[Rule]", "\"\<SM_Scotogenic_NLO\>\""}]}], "]"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"isLeptonMassive", ",", "\[IndentingNewLine]", 
      RowBox[{"WriteUFO", "[", 
       RowBox[{"LpQCD", ",", 
        RowBox[{"UVCounterterms", "\[Rule]", "UV$vertlist"}], ",", 
        RowBox[{"R2Vertices", "\[Rule]", "R2$vertlist"}], ",", " ", 
        RowBox[{
        "Output", "\[Rule]", 
         "\"\<SM_Scotogenic_MassiveLeptons_4fs_CouplingBasis_NLO\>\""}]}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"WriteUFO", "[", 
       RowBox[{"LpQCD", ",", 
        RowBox[{"UVCounterterms", "\[Rule]", "UV$vertlist"}], ",", 
        RowBox[{"R2Vertices", "\[Rule]", "R2$vertlist"}], ",", " ", 
        RowBox[{
        "Output", "\[Rule]", "\"\<SM_Scotogenic_CouplingBasis_NLO\>\""}]}], 
       "]"}]}], "\[IndentingNewLine]", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{
  3.995683572744605*^9, {4.001130284673674*^9, 4.001130285949175*^9}, {
   4.001131586822341*^9, 4.001131588933867*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"4d7fddee-7f60-4f8d-8fec-c88049c7f98d"],

